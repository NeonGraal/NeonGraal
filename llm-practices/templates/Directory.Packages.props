<Project>
  <!--
    Directory.Packages.props
    Purpose: Central Package Management (CPM) – pin ALL NuGet package versions in one file.
    Requires: ManagePackageVersionsCentrally=true (set below).

    Key decisions:
      ManagePackageVersionsCentrally=true  – every <PackageReference> in every .csproj must
        omit the Version attribute; versions are resolved from <PackageVersion> entries here.
        This prevents version drift across projects and makes auditing/upgrading trivial.

      Grouping convention used across this ecosystem:
        1. Global / analyzer packages  (listed in Directory.Build.props ItemGroup)
        2. Source project packages
        3. Test framework packages
        4. Test utility packages
        5. Framework-conditional packages (Condition="'$(TargetFramework)'=='netX.Y'")

      update.ps1 uses `dotnet outdated` to identify outdated entries; version bumps
      should be made here (minor-first, then major with exclusions).

    Customisation:
      Replace every version number below with the current release.
      Remove groups that do not apply to your project.
      Add framework-conditional ItemGroups at the bottom for packages that differ by TFM.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Analyzer / build tooling packages (referenced in Directory.Build.props) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers"         Version="5.3.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="4.14.0" />
    <PackageVersion Include="PolySharp"                                Version="1.16.0" />
  </ItemGroup>

  <!-- Source project runtime dependencies -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection"             Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging"                         Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions"            Version="10.0.0" />
    <PackageVersion Include="System.Collections.Immutable"                         Version="10.0.0" />
    <PackageVersion Include="System.Text.Json"                                     Version="10.0.0" />
  </ItemGroup>

  <!-- Test framework -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk"      Version="18.6.0" />
    <PackageVersion Include="xunit.v3"                    Version="3.2.2" />
    <PackageVersion Include="xunit.v3.assert"             Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio"   Version="3.1.5" />
  </ItemGroup>

  <!-- Test utilities -->
  <ItemGroup>
    <PackageVersion Include="AutoFixture.Xunit3"          Version="4.19.0" />
    <PackageVersion Include="AutoFixture.AutoNSubstitute"  Version="4.18.1" />
    <PackageVersion Include="NSubstitute"                  Version="5.3.0" />
    <PackageVersion Include="Shouldly"                     Version="4.3.0" />
    <PackageVersion Include="Verify.XunitV3"               Version="31.19.1" />
    <PackageVersion Include="Xunit.DependencyInjection"    Version="11.3.0" />
  </ItemGroup>

  <!--
    Framework-conditional packages: add when a package ships separate versions per TFM.
    Example:
  <ItemGroup Condition="'$(TargetFramework)'=='net9.0'">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)'=='net10.0'">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
  </ItemGroup>
  -->

</Project>
